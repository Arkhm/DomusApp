# DomusApp - Configuração de Ambiente
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente
# NUNCA commite o arquivo .env real (contém segredos)

# ===========================================
# BANCO DE DADOS (MySQL/MariaDB)
# ===========================================
DATABASE_HOST="db"
DATABASE_PORT="3306"
DATABASE_USER="root"
DATABASE_PASSWORD="sua_senha_segura"
DATABASE_NAME="domusapp"

# URL de conexão (usada pelo Prisma)
DATABASE_URL="mysql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}"

# ===========================================
# SEGREDOS DA API
# ===========================================
# Chave secreta para assinar JWTs (gere uma forte: openssl rand -base64 32)
JWT_SECRET="gere_uma_chave_forte_aqui"

# Porta onde a API vai rodar
API_PORT="3333"

# ===========================================
# MERCADO PAGO - Checkout Transparente (Orders API)
# ===========================================
# Access Token do Mercado Pago
# Sandbox:  APP_USR-3200639349572772-... (começa com APP_USR-)
# Produção: APP_USR-xxxxxxxxxxxxxxxx... (token de produção)
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-SEU_ACCESS_TOKEN_AQUI

# URL base da API do Mercado Pago (opcional, padrão: https://api.mercadopago.com)
# MERCADO_PAGO_BASE_URL=https://api.mercadopago.com

# CONTROLE DE AMBIENTE SANDBOX vs PRODUÇÃO (OBRIGATÓRIO)
# true  = Sandbox: usa payload fixo de teste do MP (50.00, test@testuser.com, APRO)
# false = Produção: usa dados reais do morador (email, nome, CPF, valor real)
# 
# IMPORTANTE: 
# - No sandbox, o MP exige valores fixos para PIX funcionar (50.00, email de teste)
# - Em produção, usa dados reais do morador cadastrado no sistema
# - Configure explicitamente para evitar detecção automática incorreta
MERCADO_PAGO_SANDBOX=true

# ===========================================
# CORS E COOKIES
# ===========================================
# Origens permitidas para CORS (separe por vírgula se houver mais de uma)
ALLOWED_ORIGIN="http://localhost:5173"

# Ambiente: development | production
# Em production o cookie de sessão exige HTTPS (secure: true)
NODE_ENV="development"

# Cookie seguro (true = só HTTPS, false = permite HTTP em dev)
# COOKIE_SECURE="false"

# SameSite do cookie: strict | lax | none
COOKIE_SAMESITE="lax"

# Confiar no proxy (necessário atrás de nginx/Railway/Render)
# TRUST_PROXY="true"

# ===========================================
# FRONTEND (Web)
# ===========================================
# URL da API para o frontend consumir
VITE_API_URL="http://localhost:3333"

# ===========================================
# EXEMPLOS DE CONFIGURAÇÃO POR AMBIENTE
# ===========================================

# --- DESENVOLVIMENTO / SANDBOX ---
# MERCADO_PAGO_SANDBOX=true
# MERCADO_PAGO_ACCESS_TOKEN=APP_USR-3200639349572772-102118-876036c37d07aebef99e9aef3aede57b-3784909734
# NODE_ENV=development

# --- PRODUÇÃO ---
# MERCADO_PAGO_SANDBOX=false
# MERCADO_PAGO_ACCESS_TOKEN=APP_USR-SEU_TOKEN_DE_PRODUCAO_AQUI
# NODE_ENV=production
# COOKIE_SECURE=true
# ALLOWED_ORIGIN=https://seudominio.com
# VITE_API_URL=https://api.seudominio.com