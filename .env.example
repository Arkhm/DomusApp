DATABASE_URL="mysql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}"

# Segredos da API
# ATENÇÃO: em produção use um segredo próprio, diferente deste exemplo.
JWT_SECRET="D0mU$@pp_S3cr3t_K3y_998877_!@#"
API_PORT="3333"

# Segurança
# Origens autorizadas a chamar a API (separe por vírgula se houver mais de uma).
ALLOWED_ORIGIN="http://localhost:5173"
# development | production — em production o cookie de sessão exige HTTPS.
NODE_ENV="development"
# Sobrescreve a flag `secure` do cookie (padrão: true só em production).
# COOKIE_SECURE="false"
# strict (padrão) | lax | none — só mude se API e front ficarem em domínios
# registráveis diferentes; nesse caso "none" exige COOKIE_SECURE="true".
# COOKIE_SAMESITE="strict"
# Quantos proxies confiar no X-Forwarded-For (Railway/Render/nginx). Sem isso o
# rate limiter enxergaria todos os clientes como um único IP.
# TRUST_PROXY="1"

# Frontend
VITE_API_URL="http://localhost:3333"
