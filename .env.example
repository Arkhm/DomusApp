# DomusApp — único exemplo de ambiente versionado.
# Copie para .env na raiz; mantenha segredos reais apenas no .env local.
# Não substitua um .env existente sem preservar suas credenciais.

# MySQL no Docker Compose: host db, porta interna 3306, porta externa 3307.
# Fora do Docker, use 127.0.0.1:3307 para acessar esse mesmo banco.
DATABASE_HOST="db"
DATABASE_PORT="3306"
DATABASE_USER="root"
DATABASE_PASSWORD="troque_esta_senha"
DATABASE_NAME="domusapp"
# Mantenha a URL sincronizada com os campos acima e codifique caracteres especiais.
# URL literal também funciona no dotenv/CLI Prisma, sem depender de interpolação.
DATABASE_URL="mysql://root:troque_esta_senha@db:3306/domusapp"

# API e autenticação. Gere JWT_SECRET com: openssl rand -hex 32
JWT_SECRET=""
API_PORT="3333"
NODE_ENV="development"
# O Compose define PORT a partir de API_PORT. Para execução direta, opcionalmente:
# PORT="3333"

# Origens permitidas, separadas por vírgula.
ALLOWED_ORIGIN="http://localhost:5173"
# Vazio: secure=true em production e false em development.
COOKIE_SECURE=""
COOKIE_SAMESITE="strict"
# Vazio em acesso direto; atrás de proxy, informe a rede/endereço confiável.
# Exemplo para proxy na mesma máquina: loopback. Não confie em toda a internet.
TRUST_PROXY=""

# Mercado Pago — Checkout Transparente via Orders API, somente Pix.
# TESTE: true + token da conta vendedora de teste. PRODUÇÃO: false + conta real.
# APP_USR pode aparecer nos dois ambientes; o prefixo não determina o ambiente.
MERCADO_PAGO_SANDBOX="true"
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_SELLER_ID=""
# Assinatura secreta gerada no painel de Webhooks; não é o Access Token.
# Obrigatória para receber webhooks e para emitir cobranças em produção.
MERCADO_PAGO_WEBHOOK_SECRET=""
# URL HTTPS a cadastrar no painel, no tópico Order e no ambiente correspondente.
# Referência operacional: esta variável não configura o painel automaticamente.
MERCADO_PAGO_WEBHOOK_URL="https://api.seudominio.com/invoices/webhook"
# O backend Pix não usa public key, senha do buyer/seller ou URL base customizada.

# Frontend web. VITE_* é público: nunca coloque tokens ou segredos aqui.
VITE_API_URL="http://localhost:3333"
# Opcional, lido pelo Vite; se executar o web isoladamente, exporte no processo.
# VITE_MOCK_MODE="false"

# Mobile (Expo), somente quando executado: exporte no processo do app.
# Em aparelho físico, substitua localhost pelo IP acessível da máquina da API.
# DOMUS_API_URL="http://localhost:3333"

# Verificação de segurança: cd api && npm run check:security
# O script lê o ambiente do processo; não carrega o .env da raiz automaticamente.
# API_URL="http://localhost:3333"
# TEST_EMAIL=""
# TEST_PASSWORD=""

# Testes automatizados de pagamentos com MySQL DESCARTÁVEL.
# Exporte estas opções no processo de npm test; não aponte para o banco de uso.
# RUN_PAYMENT_INTEGRATION="false"
# DATABASE_NAME deve terminar em _test quando RUN_PAYMENT_INTEGRATION=true.
# Também ajuste DATABASE_HOST/PORT/USER/PASSWORD/URL para o banco descartável.

# Produção: NODE_ENV=production, COOKIE_SECURE=true, origens/URLs HTTPS reais,
# MERCADO_PAGO_SANDBOX=false, credencial do vendedor real e assinatura de webhook.
# COOKIE_SAMESITE=none exige COOKIE_SECURE=true e proteção apropriada entre sites.
