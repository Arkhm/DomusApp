DATABASE_HOST="db"
DATABASE_PORT="3306"
DATABASE_USER="root"
DATABASE_PASSWORD=""
DATABASE_NAME="domusapp"

DATABASE_URL="mysql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}"

# Segredos da API
# ATENÇÃO: em produção use um segredo próprio, diferente deste exemplo.
JWT_SECRET="D0mU$@pp_S3cr3t_K3y_998877_!@#"
API_PORT="3333"

# Segurança
# Origens autorizadas a chamar a API (separe por vírgula se houver mais de uma).
ALLOWED_ORIGIN="http://localhost:5173,http://localhost:8082"
# development | production — em production o cookie de sessão exige HTTPS.
NODE_ENV="development"
# Sobrescreve a flag `secure` do cookie (padrão: true só em production).
# COOKIE_SECURE="false"
# strict (padrão) | lax | none — só mude se API e front ficarem em domínios
# registráveis diferentes; nesse caso "none" exige COOKIE_SECURE="true".
# COOKIE_SAMESITE="strict"
# Quantos proxies confiar no X-Forwarded-For (Railway/Render/nginx). Sem isso o
# rate limiter enxergaria todos os clientes como um único IP.
# TRUST_PROXY="1"

# Segredo do refresh token. Precisa ser DIFERENTE do JWT_SECRET: se forem
# iguais, um access token roubado serve para chamar /auth/refresh. Quando esta
# variável não é definida, a API deriva um valor distinto do JWT_SECRET
# automaticamente — funciona, mas em produção defina o seu.
# JWT_REFRESH_SECRET="outro_segredo_bem_diferente_do_de_cima"

# RF-007 — recuperação de senha (envio do link por email).
# Sem SMTP_HOST configurado, o nodemailer não envia nada pela rede: o link é
# impresso no log da API. É o modo esperado em desenvolvimento e na banca.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="conta@exemplo.com"
# SMTP_PASS="senha_de_app"
# SMTP_SECURE="false"
# MAIL_FROM="DomusApp <nao-responda@domusapp.local>"
# Base do link enviado no email (endereço do front, não da API).
APP_URL="http://localhost:5173"

# Frontend
VITE_API_URL="http://localhost:3333"
