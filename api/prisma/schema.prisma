generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  cpf            String   @unique
  telefone       String?         
  password       String
  role           String   @default("MORADOR")
  unidade        String?     
  status         String   @default("ATIVO") 
  is_sindico     Boolean  @default(false)
  is_conselheiro Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}