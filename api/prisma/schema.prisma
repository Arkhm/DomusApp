// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  cpf             String   @unique
  telefone        String?
  password        String
  perfil          String   @default("morador")   // morador | administrador | funcionario
  unidade         String?                         // Only for morador
  status          String   @default("ativo")      // ativo | inativo
  is_sindico      Boolean  @default(false)
  is_conselheiro  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}