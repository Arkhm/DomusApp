generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  cpf             String   @unique
  phone           String? 
  password        String
  role            String   @default("MORADOR")
  status          String   @default("ACTIVE") 
  isSyndic        Boolean  @default(false)   
  isCouncilMember Boolean  @default(false)   
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // RF-007 — recuperação de senha. `resetToken` guarda o SHA-256 do token que
  // foi enviado por email, nunca o token em si: se o banco vazar, os hashes não
  // servem para trocar a senha de ninguém.
  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  // Instante da última troca de senha. O /auth/refresh recusa refresh tokens
  // emitidos antes disso, então um reset derruba as sessões antigas em vez de
  // deixá-las vivas pelos 7 dias restantes do refresh token.
  passwordChangedAt DateTime?

  unitId          String?  
  unit            Unit?    @relation(fields: [unitId], references: [id])

  notices         Notice[] @relation("NoticeAuthor")
  events          Event[]  @relation("EventAuthor")
  votings         Voting[] @relation("VotingAuthor")
  noticeReads     NoticeRead[]
  notificationReads NotificationRead[]
  votingVotes     VotingVote[]
  pets            Pet[]
}

model NotificationRead {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type     String   @db.VarChar(10)
  sourceId String
  readAt   DateTime @default(now())

  @@unique([userId, type, sourceId])
}

model Unit {
  id          String   @id @default(uuid())
  type        String   @default("APARTMENT") // "APARTMENT" | "HOUSE"
  block       String? 
  number      String  
  parkingSpots Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  residents   User[]

  notices     Notice[] @relation("NoticeTargetUnit")
  vehicles    Vehicle[]
  events      Event[]  @relation("EventTargetUnit")
}

model Notice {
  id           String   @id @default(uuid())
  title        String
  content      String   @db.Text
  targetType   String   @default("ALL")

  status       String   @default("PUBLISHED") 
  priority     String   @default("NORMAL")    

  targetUnitId String?
  targetUnit   Unit?    @relation("NoticeTargetUnit", fields: [targetUnitId], references: [id])

  // Autor do aviso
  authorId     String
  author       User     @relation("NoticeAuthor", fields: [authorId], references: [id])

  readBy       NoticeRead[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model NoticeRead {
  id       String   @id @default(uuid())
  noticeId String
  notice   Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt   DateTime @default(now())

  @@unique([noticeId, userId])
  @@index([userId])
}

model Event {
  id           String   @id @default(uuid())
  title        String
  content      String   @db.Text
  eventDate    DateTime
  location     String?
  targetType   String   @default("ALL")

  category     String   @default("OUTRO")     
  capacity     Int?
  status       String   @default("PUBLISHED") 

  targetUnitId String?
  targetUnit   Unit?    @relation("EventTargetUnit", fields: [targetUnitId], references: [id])

  authorId     String
  author       User     @relation("EventAuthor", fields: [authorId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Voting {
  id          String         @id @default(uuid())
  title       String
  description String         @db.Text
  startDate   DateTime
  endDate     DateTime
  authorId    String
  author      User           @relation("VotingAuthor", fields: [authorId], references: [id])
  options     VotingOption[]
  ballots     VotingVote[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model VotingOption {
  id        String       @id @default(uuid())
  text      String
  votingId  String
  voting    Voting       @relation(fields: [votingId], references: [id], onDelete: Cascade)
  votes     Int          @default(0)
  ballots   VotingVote[]
  createdAt DateTime     @default(now())
}

// Voto individual de um morador. `votes` em VotingOption continua sendo a
// contagem exibida; esta tabela só garante um voto por morador por votação
// (a unique composta) e permite dizer ao app em quem o morador votou. Se o
// usuário for apagado, o registro some mas a contagem do resultado permanece.
model VotingVote {
  id        String       @id @default(uuid())
  votingId  String
  voting    Voting       @relation(fields: [votingId], references: [id], onDelete: Cascade)
  optionId  String
  option    VotingOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([votingId, userId])
  @@index([optionId])
  @@index([userId])
}

model Vehicle {
  id        String   @id @default(uuid())
  plate     String   @unique 
  model     String
  color     String?
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pet {
  id        String   @id @default(uuid())
  name      String
  species   String 
  size      String   
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
