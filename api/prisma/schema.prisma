generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// Raiz do isolamento multi-tenant. Cada condomínio é um inquilino: todo dado
// operacional (usuários, unidades, avisos, eventos, votações) pertence a
// exatamente um Condominium e nunca deve cruzar essa fronteira.
//
// O ADMIN (super admin da plataforma) opera acima da restrição; síndico e
// moradores ficam confinados ao seu `condominiumId`.
model Condominium {
  id        String   @id @default(uuid())
  name      String
  cnpj      String?  @unique
  address   String?
  city      String?
  state     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   User[]
  units   Unit[]
  notices Notice[]
  events  Event[]
  votings Voting[]
}

model User {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  cpf             String   @unique
  phone           String? 
  password        String
  role            String   @default("MORADOR")
  status          String   @default("ACTIVE") 
  isSyndic        Boolean  @default(false)   
  isCouncilMember Boolean  @default(false)   
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  condominiumId   String
  condominium     Condominium @relation(fields: [condominiumId], references: [id])

  unitId          String?  
  unit            Unit?    @relation(fields: [unitId], references: [id])

  notices         Notice[] @relation("NoticeAuthor")
  events          Event[]  @relation("EventAuthor")
  votings         Voting[] @relation("VotingAuthor")
  noticeReads     NoticeRead[]
}

model Unit {
  id          String   @id @default(uuid())
  type        String   @default("APARTMENT") // "APARTMENT" | "HOUSE"
  block       String?  // APARTMENT: bloco/torre · HOUSE: quadra/setor (opcional)
  number      String   // identificador da unidade (número do apto ou da casa)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  condominiumId String
  condominium   Condominium @relation(fields: [condominiumId], references: [id])

  residents   User[]

  notices     Notice[] @relation("NoticeTargetUnit")
  events      Event[]  @relation("EventTargetUnit")
}

model Notice {
  id           String   @id @default(uuid())
  title        String
  content      String   @db.Text
  targetType   String   @default("ALL")

  status       String   @default("PUBLISHED") // "DRAFT" | "PUBLISHED"
  priority     String   @default("NORMAL")    // "NORMAL" | "URGENT"

  condominiumId String
  condominium   Condominium @relation(fields: [condominiumId], references: [id])

  targetUnitId String?
  targetUnit   Unit?    @relation("NoticeTargetUnit", fields: [targetUnitId], references: [id])

  // Autor do aviso
  authorId     String
  author       User     @relation("NoticeAuthor", fields: [authorId], references: [id])

  readBy       NoticeRead[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// NoticeRead e VotingOption não carregam `condominiumId` de propósito: são
// filhos com `onDelete: Cascade` e herdam o escopo do pai (Notice / Voting).
model NoticeRead {
  id       String   @id @default(uuid())
  noticeId String
  notice   Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt   DateTime @default(now())

  @@unique([noticeId, userId])
  @@index([userId])
}

model Event {
  id           String   @id @default(uuid())
  title        String
  content      String   @db.Text
  eventDate    DateTime
  location     String?
  targetType   String   @default("ALL")

  category     String   @default("OUTRO")     // ASSEMBLEIA | CONFRATERNIZACAO | MANUTENCAO | REUNIAO | OUTRO
  capacity     Int?
  status       String   @default("PUBLISHED") // DRAFT | PUBLISHED | CANCELLED

  condominiumId String
  condominium   Condominium @relation(fields: [condominiumId], references: [id])

  targetUnitId String?
  targetUnit   Unit?    @relation("EventTargetUnit", fields: [targetUnitId], references: [id])

  authorId     String
  author       User     @relation("EventAuthor", fields: [authorId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Voting {
  id          String         @id @default(uuid())
  title       String
  description String         @db.Text
  startDate   DateTime
  endDate     DateTime

  condominiumId String
  condominium   Condominium  @relation(fields: [condominiumId], references: [id])

  authorId    String
  author      User           @relation("VotingAuthor", fields: [authorId], references: [id])
  options     VotingOption[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model VotingOption {
  id        String   @id @default(uuid())
  text      String
  votingId  String
  voting    Voting   @relation(fields: [votingId], references: [id], onDelete: Cascade)
  votes     Int      @default(0)
  createdAt DateTime @default(now())
}
