// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  cpf             String   @unique
  phone           String? 
  password        String
  role            String   @default("MORADOR")
  status          String   @default("ACTIVE") 
  isSyndic        Boolean  @default(false)   
  isCouncilMember Boolean  @default(false)   
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  unitId          String?  
  unit            Unit?    @relation(fields: [unitId], references: [id])

  notices         Notice[] @relation("NoticeAuthor")
}

model Unit {
  id          String   @id @default(uuid())
  block       String? 
  number      String   
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  residents   User[]
  
  notices     Notice[] @relation("NoticeTargetUnit")
}

model Notice {
  id           String   @id @default(uuid())
  title        String
  content      String   @db.Text 
  targetType   String   @default("ALL") 
  
  targetUnitId String?
  targetUnit   Unit?    @relation("NoticeTargetUnit", fields: [targetUnitId], references: [id])
  
  // Autor do aviso
  authorId     String
  author       User     @relation("NoticeAuthor", fields: [authorId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  telefone        String?
  password        String
  perfil          String   @default("morador")   // morador | administrador | funcionario
  unidade         String?                         // Only for morador
  status          String   @default("ativo")      // ativo | inativo
  is_sindico      Boolean  @default(false)
  is_conselheiro  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}