// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  email      String   @unique @db.VarChar(120)
  telefone   String?  @db.VarChar(20)
  password   String   @db.VarChar(255)
  role_id    Int
  unit_id    Int?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime? @updatedAt

  role       Role     @relation(fields: [role_id], references: [id])
  unit       Unit?    @relation(fields: [unit_id], references: [id])
  notices    Notice[] @relation("NoticeAuthor")

  @@map("users")
}

model Role {
  id         Int      @id @default(autoincrement())
  name       String   @unique @db.VarChar(50)
  created_at DateTime @default(now())
  users      User[]

  @@map("roles")
}

model Unit {
  id         Int      @id @default(autoincrement())
  block      String   @db.VarChar(10)
  number     String   @db.VarChar(10)
  created_at DateTime @default(now())
  users      User[]
  notices    Notice[] @relation("NoticeTargetUnit")

  @@map("units")
}

model Notice {
  id           Int      @id @default(autoincrement())
  title        String   @db.VarChar(255)
  content      String   @db.Text
  targetType   String   @default("ALL")

  targetUnitId Int?
  targetUnit   Unit?    @relation("NoticeTargetUnit", fields: [targetUnitId], references: [id])

  authorId     Int
  author       User     @relation("NoticeAuthor", fields: [authorId], references: [id])

  created_at   DateTime @default(now())
  updated_at   DateTime? @updatedAt

  @@map("notices")
}