{
  "name": "api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "dev": "tsx watch src/server.ts",
    "check:security": "node scripts/security-check.mjs",
    "typecheck": "tsc --noEmit",
    "payments:worker": "tsx src/workers/paymentWorker.ts",
    "start": "node dist/server.js",
    "db:deploy": "prisma migrate deploy",
    "payments:verify": "node --env-file=../.env --import tsx scripts/verify-mercado-pago.ts",
    "test:coverage": "c8 --all --src=src --include=src/services/** --include=src/repositories/** --reporter=text-summary --reporter=text --check-coverage --lines=70 npm test",
    "build": "tsc --rootDir src --outDir dist --sourceMap false src/server.ts src/workers/paymentWorker.ts --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --esModuleInterop --skipLibCheck",
    "payments:worker:prod": "node dist/workers/paymentWorker.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-fetch": "^3.3.2",
    "nodemailer": "^10.0.1",
    "pino": "^10.4.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.3",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "c8": "^12.0.0",
    "prisma": "^7.4.2",
    "supertest": "^7.3.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
